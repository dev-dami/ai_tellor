{
  "name": "barber-whatsapp-bot",
  "version": "1.0.0",
  "description": "WhatsApp sales bot for barber training academy",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch --onSuccess \"node dist/server.js\"",
    "start": "node dist/server.js",
    "lint": "biome lint src",
    "format": "biome format --write src",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.17.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "axios": "^1.7.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3",
    "openai": "^4.53.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.8.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.11",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "prisma": "^5.17.0",
    "tsup": "^8.1.0",
    "typescript": "^5.5.3"
  }
}
